  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdaneri/vmware-workstation-mcp.git"
  },
  "type": "module",
  "scripts": {
    "security:probe": "node scripts/probe-security.mjs",
    "build": "node scripts/build.mjs",
